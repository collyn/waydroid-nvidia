# Compatibility entry point for the existing CI/dev AndroidX64 build.
# Keep this in sync with args-x86_64.gn until callers use the explicit file.
target_os = "android"
target_cpu = "x64"
is_debug = false
is_component_build = false
angle_libs_suffix = "_angle"
android_ndk_api_level = 30
angle_enable_swiftshader = false
# NVIDIA needs ANGLE's CPU ASTC-to-RGBA upload fallback for ASTC-only games.
angle_has_astc_encoder = true
