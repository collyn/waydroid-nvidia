target_os = "android"
target_cpu = "x64"
is_debug = false
is_component_build = false
angle_libs_suffix = "_angle"
android_ndk_api_level = 30
angle_enable_swiftshader = false
# Android disables this by default. NVIDIA has no native ASTC, and games
# shipping ASTC-only atlases need ANGLE's RGBA decode fallback.
angle_has_astc_encoder = true
